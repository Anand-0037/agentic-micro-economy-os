# Mantle
MANTLE_RPC_URL=https://rpc.mantle.xyz
MANTLE_CHAIN_ID=5000
MANTLE_USDC_ADDRESS=
MANTLE_WETH_ADDRESS=
TREASURY_EOA=0x...
AGENT_PRIVATE_KEY=0x...
AGENT_IDENTITY_ADDRESS=0x...
AGENT_TOKEN_ID=0

# Mantle Sepolia DEX (Merchant Moe / FusionX fallback — see docs/LOCKED.md)
EXECUTION_ADAPTER=mantle_dex
MERCHANT_MOE_ROUTER=
MERCHANT_MOE_FACTORY=
MERCHANT_MOE_POOL_USDC_WMNT=
MANTLE_WMNT_ADDRESS=
FUSIONX_V2_ROUTER=0x45e6f621c5ED8616cCFB9bBaeBAcF9638aBB0033
FUSIONX_V2_FACTORY=0x272465431A6b86E3B9E5b9bD33f5D103a3F59eDb
FUSIONX_USDC=0xc92747b1e4Bd5F89BBB66bAE657268a5F4c4850C
FUSIONX_WBIT=0x8734110e5e1dcF439c7F549db740E546fea82d66
FUSIONX_POOL_USDC_WBIT=
DEX_SLIPPAGE_BPS=100
DEX_SWAP_DEADLINE_SEC=300

# Inference — Z.ai is sponsor primary (production requires z_ai)
LLM_PROVIDER=z_ai

# Z.ai (optional)
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/paas/v4
Z_AI_MODEL=glm-5-turbo

# Groq (optional alternate — not used in production)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro-002

# 0G Storage (wallet auth via CLI — NOT an HTTP API key)
# Galileo testnet example — use your QuickNode/dRPC URL for ZERO_G_RPC_URL
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_PRIVATE_KEY=
ZERO_G_CLI_PATH=0g-storage-client
ZERO_G_TIMEOUT_SEC=120
ZERO_G_NAMESPACE=ameo-prod
# Galileo testnet: RPC https://evmrpc-testnet.0g.ai | indexer https://indexer-storage-testnet-turbo.0g.ai

# Prompt registry
PROMPT_REGISTRY_PATH=

# Memory DB (relative paths resolve under agentic-micro-economy-os/)
MEMORY_DB_PATH=data/ameo.db
VOLATILITY_THRESHOLD_PCT=0.05
AGENT_INTERVAL_SEC=300

# Bybit signals
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Web (public in browser bundle — same project DSN is OK)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Source map upload (optional; gitignore .env.sentry-build-plugin)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=abes-engineering-college-cd
SENTRY_PROJECT=turing-test

# Eval harness (optional path; default apps/worker/eval_report.json)
EVAL_REPORT_PATH=

# Operations (PRD appendix)
LIVE_ENABLED=false
WORKER_MODE=dry_run
# dry_run | live_limited | live
MAX_DAILY_VOLUME_USD=0
MAX_POSITION_USD=
PROMPT_SET_VERSION=v1

# --- Vite (web build / Docker build args; public in browser bundle) ---
# VITE_WORKER_URL=http://localhost:8000
# VITE_MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
# VITE_MANTLE_CHAIN_ID=5003
# VITE_AGENT_IDENTITY_ADDRESS=
# VITE_AGENT_TOKEN_ID=0
# VITE_MANTLE_EXPLORER_BASE=https://explorer.mantle.xyz
# VITE_LOG_FROM_BLOCK=0
# VITE_TREASURY_EOA=
# VITE_DOCS_URL=http://localhost:3000
# VITE_GITHUB_URL=
# VITE_APP_VERSION=0.1.0
# VITE_0G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
