# --- Mantle Sepolia (the ONLY chain AMEO runs on) ---
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_RPC_URL_FALLBACK=https://rpc.ankr.com/mantle_sepolia
MANTLE_CHAIN_ID=5003
MANTLE_EXPLORER_BASE=https://sepolia.mantlescan.xyz
MANTLE_USDC_ADDRESS=0xc92747b1e4Bd5F89BBB66bAE657268a5F4c4850C

# --- Agent identity (ERC-8004 deployment) ---
AGENT_IDENTITY_ADDRESS=0xEc14f781DB5f5f350F26Bc10Fb8f654e1D91daCc
AGENT_TOKEN_ID=0
AGENT_EOA=0xFB76C4B6912bCF358752Fb4b4b15B959EfaDD915
AGENT_PRIVATE_KEY=

# --- Treasury (rotate keys via cast wallet new; never commit secrets) ---
TREASURY_EOA=0x47933b98Be8Feedf63dE822B3ce7408D027B4108
TREASURY_PRIVATE_KEY=

# --- DEX: FusionX V2 (real adapter — UI labels read from env, not hardcoded copy) ---
EXECUTION_ADAPTER=fusionx_v2
FUSIONX_V2_ROUTER=0x45e6f621c5ED8616cCFB9bBaeBAcF9638aBB0033
FUSIONX_V2_FACTORY=0x272465431A6b86E3B9E5b9bD33f5D103a3F59eDb
FUSIONX_USDC=0xc92747b1e4Bd5F89BBB66bAE657268a5F4c4850C
# WBIT (wrapped native on FusionX testnet docs) used as WMNT equivalent
FUSIONX_WMNT=0x8734110e5e1dcF439c7F549db740E546fea82d66
MANTLE_WMNT_ADDRESS=0x8734110e5e1dcF439c7F549db740E546fea82d66
# Computed via factory.getPair / create2 using init hash from FusionX V2 testnet docs (may be 0x0 until pair created via factory)
FUSIONX_POOL_USDC_WMNT=0xbada34a8738a6c0b732d8D995e568c8d2A6330d9
DEX_SLIPPAGE_BPS=100
DEX_SWAP_DEADLINE_SEC=300

# --- API protection (set for public deployments; clients must send header X-API-KEY) ---
API_KEY=

# --- LLM fallback chain (W3 locked: z.ai → Groq → Gemini → local_rules) ---
LLM_PROVIDER=z_ai
LLM_PROVIDER_CHAIN=z_ai,groq,gemini,local_rules
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/paas/v4
Z_AI_MODEL=glm-4-plus
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- 0G Galileo (testnet) ---
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_PRIVATE_KEY=
ZERO_G_CLI_PATH=0g-storage-client
ZERO_G_TIMEOUT_SEC=120
ZERO_G_NAMESPACE=ameo-prod

# --- Worker behaviour (align with claimed replay) ---
AGENT_INTERVAL_SEC=60
VOLATILITY_THRESHOLD_PCT=0.03
MAX_DAILY_VOLUME_USD=500
MAX_POSITION_USD=250
WORKER_MODE=live_limited
LIVE_ENABLED=true
PROMPT_SET_VERSION=v1
PROMPT_REGISTRY_PATH=packages/prompts

# --- Memory (Render: mount persistent disk at /var/data) ---
MEMORY_DB_PATH=data/ameo.db

# --- Observability ---
SENTRY_DSN=
SENTRY_ORG=agiwithai
SENTRY_PROJECT=ameo-worker
SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# --- Eval harness (optional) ---
EVAL_REPORT_PATH=

# --- Frontend (Vite — public in browser bundle) ---
VITE_WORKER_URL=http://localhost:8000
VITE_MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
VITE_MANTLE_RPC_URL_FALLBACK=https://rpc.ankr.com/mantle_sepolia
VITE_MANTLE_CHAIN_ID=5003
VITE_MANTLE_EXPLORER_BASE=https://sepolia.mantlescan.xyz
VITE_AGENT_IDENTITY_ADDRESS=0xEc14f781DB5f5f350F26Bc10Fb8f654e1D91daCc
VITE_AGENT_TOKEN_ID=0
VITE_AGENT_EOA=0xFB76C4B6912bCF358752Fb4b4b15B959EfaDD915
VITE_TREASURY_EOA=0x47933b98Be8Feedf63dE822B3ce7408D027B4108
VITE_LOG_FROM_BLOCK=12500000
VITE_DOCS_URL=https://docs.ameo.agiwithai.com
VITE_GITHUB_URL=https://github.com/Anand-0037/agentic-micro-economy-os
VITE_0G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
VITE_APP_VERSION=0.2.0

# UI labels — must match worker config (no hardcoded marketing copy in components)
VITE_EXECUTION_ADAPTER=fusionx_v2
VITE_EXECUTION_ADAPTER_LABEL=FusionX V2 DEX
VITE_FUSIONX_V2_ROUTER=0x45e6f621c5ED8616cCFB9bBaeBAcF9638aBB0033
VITE_FUSIONX_WMNT=0x8734110e5e1dcF439c7F549db740E546fea82d66
VITE_FUSIONX_POOL_USDC_WMNT=0xbada34a8738a6c0b732d8D995e568c8d2A6330d9
VITE_LLM_PROVIDER_LABEL=z.ai
VITE_Z_AI_MODEL=glm-4-plus
VITE_GROQ_MODEL=llama-3.3-70b-versatile
VITE_GEMINI_MODEL=gemini-2.5-pro
VITE_VOLATILITY_THRESHOLD_PCT=0.03
VITE_MAX_TRADE_USD=250
VITE_SIGNING_METHOD=Hot EOA Private Key (Isolated .env)

# --- Removed (out of scope / stale) ---
# BYBIT_* — centralized exchange signals removed; use on-chain + DexScreener
# MANTLE_WETH_* — AMEO trades USDC/MNT, not WETH
# MERCHANT_MOE_* — FusionX V2 is the Sepolia execution path
