FROM node:20-alpine AS builder

WORKDIR /app
COPY apps/web/package*.json ./
RUN npm install
COPY apps/web ./

ARG VITE_WORKER_URL=http://localhost:8000
ARG VITE_MANTLE_RPC_URL=https://rpc.mantle.xyz
ARG VITE_MANTLE_CHAIN_ID=5000
ARG VITE_AGENT_IDENTITY_ADDRESS=0x0000000000000000000000000000000000000000
ARG VITE_AGENT_TOKEN_ID=0
ARG VITE_MANTLE_EXPLORER_BASE=https://explorer.mantle.xyz
ARG VITE_LOG_FROM_BLOCK=0
ARG VITE_TREASURY_EOA=0x0000000000000000000000000000000000000000
ARG VITE_DOCS_URL=
ARG VITE_GITHUB_URL=
ARG VITE_APP_VERSION=0.1.0
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_ENVIRONMENT=production
ARG VITE_0G_INDEXER_URL=https://indexer-storage-turbo.0g.ai

ENV VITE_WORKER_URL=$VITE_WORKER_URL
ENV VITE_MANTLE_RPC_URL=$VITE_MANTLE_RPC_URL
ENV VITE_MANTLE_CHAIN_ID=$VITE_MANTLE_CHAIN_ID
ENV VITE_AGENT_IDENTITY_ADDRESS=$VITE_AGENT_IDENTITY_ADDRESS
ENV VITE_AGENT_TOKEN_ID=$VITE_AGENT_TOKEN_ID
ENV VITE_MANTLE_EXPLORER_BASE=$VITE_MANTLE_EXPLORER_BASE
ENV VITE_LOG_FROM_BLOCK=$VITE_LOG_FROM_BLOCK
ENV VITE_TREASURY_EOA=$VITE_TREASURY_EOA
ENV VITE_DOCS_URL=$VITE_DOCS_URL
ENV VITE_GITHUB_URL=$VITE_GITHUB_URL
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT
ENV VITE_0G_INDEXER_URL=$VITE_0G_INDEXER_URL

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
