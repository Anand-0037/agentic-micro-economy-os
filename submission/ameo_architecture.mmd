graph TD
    subgraph Mantle Sepolia Network
        RPC[Mantle Sepolia RPC]
        FusionX[FusionX V2 DEX Router]
        Identity[ERC-8004 Identity Contract]
    end

    subgraph AMEO Python Worker (FastAPI + LangGraph)
        Observe[1. Observe State: Balances, Prices, Gas]
        Decide[2. Reason & Plan: z.ai -> Groq -> Gemini fallback chain]
        Policy[3. Deterministic Policy Check: 7 Guardrails]
        Signer[4. Transaction Signer: Hot EOA / KMS]
    end

    subgraph Decentralized Storage
        OG[0G Storage testnet client]
    end

    subgraph Narrative Console (React + Vite)
        UI[Dynamic Replay Console UI]
        Verify[Verify Endpoint: GET /v1/verify/txHash]
    end

    %% Flow Directions
    RPC -->|Balances, Gas, Market Signals| Observe
    Observe --> Decide
    Decide -->|Plan proposal| Policy
    Decide -.->|Hash & anchor rationale| OG
    Policy -->|Pass| Signer
    Policy -->|Fail: Log Blocked event| Identity
    Signer -->|Sign & Execute Swap| FusionX
    Signer -->|Log Decision under Agent NFT| Identity
    
    UI -->|Poll Config, Status, Decisions| RPC
    UI -->|Trigger manual run-cycle| Policy
    Verify -->|Retrieve execution proof| RPC

    %% Styles
    classDef mantle fill:#e2f0d9,stroke:#3d7a5f,stroke-width:2px,color:#1f1a17;
    classDef worker fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#1f1a17;
    classDef storage fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#1f1a17;
    classDef frontend fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#1f1a17;
    classDef policy border fill:#f8cecc,stroke:#ff0000,stroke-width:3px,color:#1f1a17;

    class RPC,FusionX,Identity mantle;
    class Observe,Decide,Signer worker;
    class Policy policy;
    class OG storage;
    class UI,Verify frontend;
