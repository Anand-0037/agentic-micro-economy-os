FROM node:20-alpine AS builder

WORKDIR /app
COPY apps/web/package*.json ./
RUN npm install
COPY apps/web ./

ARG VITE_WORKER_URL=http://localhost:8000
ARG VITE_MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
ARG VITE_MANTLE_CHAIN_ID=5003
ARG VITE_AGENT_IDENTITY_ADDRESS=0x8aC72a4B26e973FCdD7dAadd960Ae0eC635b4197
ARG VITE_AGENT_TOKEN_ID=0
ARG VITE_MANTLE_EXPLORER_BASE=https://sepolia.mantlescan.xyz
ARG VITE_LOG_FROM_BLOCK=12500000
ARG VITE_TREASURY_EOA=
ARG VITE_DOCS_URL=https://docs.ameo.agiwithai.com
ARG VITE_GITHUB_URL=https://github.com/Anand-0037/agentic-micro-economy-os
ARG VITE_APP_VERSION=0.2.0
ARG VITE_SENTRY_DSN=
ARG VITE_SENTRY_ENVIRONMENT=production
ARG VITE_0G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ARG VITE_EXECUTION_ADAPTER=fusionx_v2
ARG VITE_EXECUTION_ADAPTER_LABEL=FusionX V2
ARG VITE_FUSIONX_V2_ROUTER=0x45e6f621c5ED8616cCFB9bBaeBAcF9638aBB0033
ARG VITE_LLM_PROVIDER_LABEL=z.ai
ARG VITE_Z_AI_MODEL=glm-4-plus
ARG VITE_VOLATILITY_THRESHOLD_PCT=0.03
ARG VITE_MAX_TRADE_USD=250

ENV VITE_WORKER_URL=$VITE_WORKER_URL
ENV VITE_MANTLE_RPC_URL=$VITE_MANTLE_RPC_URL
ENV VITE_MANTLE_CHAIN_ID=$VITE_MANTLE_CHAIN_ID
ENV VITE_AGENT_IDENTITY_ADDRESS=$VITE_AGENT_IDENTITY_ADDRESS
ENV VITE_AGENT_TOKEN_ID=$VITE_AGENT_TOKEN_ID
ENV VITE_MANTLE_EXPLORER_BASE=$VITE_MANTLE_EXPLORER_BASE
ENV VITE_LOG_FROM_BLOCK=$VITE_LOG_FROM_BLOCK
ENV VITE_TREASURY_EOA=$VITE_TREASURY_EOA
ENV VITE_DOCS_URL=$VITE_DOCS_URL
ENV VITE_GITHUB_URL=$VITE_GITHUB_URL
ENV VITE_APP_VERSION=$VITE_APP_VERSION
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT
ENV VITE_0G_INDEXER_URL=$VITE_0G_INDEXER_URL
ENV VITE_EXECUTION_ADAPTER=$VITE_EXECUTION_ADAPTER
ENV VITE_EXECUTION_ADAPTER_LABEL=$VITE_EXECUTION_ADAPTER_LABEL
ENV VITE_FUSIONX_V2_ROUTER=$VITE_FUSIONX_V2_ROUTER
ENV VITE_LLM_PROVIDER_LABEL=$VITE_LLM_PROVIDER_LABEL
ENV VITE_Z_AI_MODEL=$VITE_Z_AI_MODEL
ENV VITE_VOLATILITY_THRESHOLD_PCT=$VITE_VOLATILITY_THRESHOLD_PCT
ENV VITE_MAX_TRADE_USD=$VITE_MAX_TRADE_USD

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
